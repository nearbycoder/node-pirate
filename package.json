{
  "name": "node-pirate",
  "version": "1.0.1",
  "description": "A resilient OpenTUI client for discovering legal torrent metadata indexed by The Pirate Bay",
  "type": "module",
  "bin": {
    "node-pirate": "dist/node-pirate.js"
  },
  "files": [
    "dist/node-pirate.js",
    "Readme.md"
  ],
  "scripts": {
    "dev": "bun run src/cli.ts",
    "start": "bun run src/cli.ts",
    "build": "bun build src/cli.ts --target=bun --packages=external --outfile=dist/node-pirate.js --banner='#!/usr/bin/env bun'",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run typecheck && bun test && bun run build",
    "prepack": "bun run build"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "packageManager": "npm@11.16.0",
  "author": "nearbycoder",
  "homepage": "https://github.com/nearbycoder/node-pirate",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nearbycoder/node-pirate.git"
  },
  "license": "(ISC OR GPL-3.0-only)",
  "dependencies": {
    "@opentui/core": "0.5.1",
    "commander": "15.0.0"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "7.0.2"
  }
}
